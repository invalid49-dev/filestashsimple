# FileStash Environment Configuration

# ============================================
# Cache Configuration
# ============================================

# Use optimized cache strategy for fast loading
CACHE_STRATEGY=optimized

# Hot cache size (number of records to keep in memory)
HOT_CACHE_SIZE=10000

# Query cache size in bytes (100MB)
QUERY_CACHE_SIZE=104857600

# ============================================
# Search Configuration
# ============================================

# Maximum number of search results to return
SEARCH_LIMIT=1000

# Search operation timeout in milliseconds
SEARCH_TIMEOUT=5000

# ============================================
# Performance Configuration
# ============================================

# Number of threads for file system scanning
SCAN_THREADS=4

# Batch size for database operations
BATCH_SIZE=1000

# ============================================
# Feature Flags
# ============================================

# Enable cache statistics endpoint and logging
ENABLE_CACHE_STATS=true

# Enable lazy loading for tree view
ENABLE_LAZY_LOADING=true

# Enable query result caching
ENABLE_QUERY_CACHE=true

# ============================================
# Server Configuration
# ============================================

# HTTP server port
PORT=3000

# Automatically open browser on server start
AUTO_OPEN_BROWSER=true

# ============================================
# Logging Configuration
# ============================================

# Logging verbosity level (debug, info, warn, error)
LOG_LEVEL=info

# Interval for periodic cache statistics logging (5 minutes)
LOG_CACHE_STATS_INTERVAL=300000
