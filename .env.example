# FileStash Environment Configuration
# Copy this file to .env and adjust values as needed

# ============================================
# Cache Configuration
# ============================================

# Cache strategy: full, optimized, minimal, tiered
# - full: Load entire database into memory (high memory, fast)
# - optimized: Three-tier caching (low memory, good performance)
# - minimal: Minimal caching (not yet implemented)
# - tiered: Advanced tiered caching (not yet implemented)
CACHE_STRATEGY=optimized

# Hot cache size (number of records to keep in memory)
# Range: 1,000 - 100,000
# Higher values = better hit rate but more memory
HOT_CACHE_SIZE=10000

# Query cache size in bytes (for caching query results)
# Range: 10MB - 500MB
# 104857600 = 100MB, 209715200 = 200MB
QUERY_CACHE_SIZE=104857600

# ============================================
# Search Configuration
# ============================================

# Maximum number of search results to return
# Range: 100 - 10,000
SEARCH_LIMIT=1000

# Search operation timeout in milliseconds
# Range: 1,000 - 30,000
SEARCH_TIMEOUT=5000

# ============================================
# Performance Configuration
# ============================================

# Number of threads for file system scanning
# Range: 1 - 16
# Recommended: Number of CPU cores
SCAN_THREADS=4

# Batch size for database operations
# Range: 100 - 10,000
BATCH_SIZE=1000

# ============================================
# Feature Flags
# ============================================

# Enable cache statistics endpoint (/api/cache/stats) and logging
# Options: true, false, 1, 0, yes, no
ENABLE_CACHE_STATS=true

# Enable lazy loading for tree view
ENABLE_LAZY_LOADING=true

# Enable query result caching
ENABLE_QUERY_CACHE=true

# ============================================
# Server Configuration
# ============================================

# HTTP server port
# Range: 1024 - 65535
PORT=3000

# Automatically open browser on server start
AUTO_OPEN_BROWSER=true

# ============================================
# Archiver Configuration
# ============================================

# Local archiver support
# The application will automatically detect archivers in the following locations:
# - bin/7zip/7z.exe (for ZIP and 7Z formats)
# - bin/winrar/Rar.exe (for RAR format)
#
# If local archivers are not found, the application will fall back to system-installed archivers:
# - 7-Zip: C:\Program Files\7-Zip\7z.exe or in PATH
# - WinRAR: C:\Program Files\WinRAR\Rar.exe or in PATH
#
# Supported archive formats:
# - ZIP: Created with 7-Zip
# - 7Z: Created with 7-Zip (default format)
# - RAR: Created with WinRAR
#
# To use local archivers:
# 1. Create directories: bin/7zip and bin/winrar
# 2. Download portable versions:
#    - 7-Zip: https://www.7-zip.org/download.html (7-Zip Extra: standalone console version)
#    - WinRAR: https://www.rarlab.com/download.htm (WinRAR command line version)
# 3. Extract 7z.exe to bin/7zip/
# 4. Extract Rar.exe to bin/winrar/
# 5. Restart the application
#
# The application will log detected archivers on startup

# ============================================
# Logging Configuration
# ============================================

# Logging verbosity level
# Options: debug, info, warn, error
LOG_LEVEL=info

# Interval for periodic cache statistics logging (milliseconds)
# Range: 60,000 - 3,600,000 (1 minute - 1 hour)
# 300000 = 5 minutes, 600000 = 10 minutes
LOG_CACHE_STATS_INTERVAL=300000

# ============================================
# Preset Configurations
# ============================================

# Uncomment one of the following presets or customize above

# --- Large Database (1M+ files) ---
# CACHE_STRATEGY=optimized
# HOT_CACHE_SIZE=20000
# QUERY_CACHE_SIZE=209715200
# SEARCH_LIMIT=2000
# SCAN_THREADS=8
# BATCH_SIZE=2000

# --- Small Database (<100K files) ---
# CACHE_STRATEGY=full
# HOT_CACHE_SIZE=5000
# QUERY_CACHE_SIZE=52428800
# SEARCH_LIMIT=1000
# SCAN_THREADS=4

# --- Memory-Constrained System ---
# CACHE_STRATEGY=optimized
# HOT_CACHE_SIZE=5000
# QUERY_CACHE_SIZE=52428800
# ENABLE_QUERY_CACHE=false
# SEARCH_LIMIT=500
# SCAN_THREADS=2

# --- High-Performance System ---
# CACHE_STRATEGY=optimized
# HOT_CACHE_SIZE=50000
# QUERY_CACHE_SIZE=524288000
# SEARCH_LIMIT=5000
# SCAN_THREADS=16
# BATCH_SIZE=5000
